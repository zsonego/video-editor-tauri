{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "艾咔",
  "version": "0.1.1",
  "identifier": "com.loogear.aicut",
  "build": {
    "beforeDevCommand": "node scripts/prepare-native-dev.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "艾咔",
        "width": 1280,
        "height": 850,
        "minWidth": 1100,
        "minHeight": 720,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$LOCALDATA/aicut/template/**",
          "$APPDATA/aicut/template/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEMDYwNjM4ODIzQTU4QUEKUldTcVdEcUNPQVlHZmFlZHg2UWVsN1RZYjY3Q0ZlVTNUTENUbmhxbDgwN2tPQWtsVVFCMm1BcC8K",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/luts/": "luts/"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
